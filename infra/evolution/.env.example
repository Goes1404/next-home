# Copie para `.env` NO SERVIDOR e preencha. Este arquivo nunca deve ser
# commitado com valores reais — o .gitignore ao lado já cuida disso.

# Domínio que aponta (registro A) para o IP deste servidor.
# Ex.: evo.nexthomeimobiliaria.com.br
EVOLUTION_DOMAIN=

# Chave mestra da Evolution. É a mesma que vai em WHATSAPP_API_KEY na Vercel.
# Gere uma nova com:  openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
AUTHENTICATION_API_KEY=

# Senha do Postgres interno da Evolution (não é o Supabase do site).
POSTGRES_PASSWORD=
