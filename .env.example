# Copie para .env.local e preencha com os valores do projeto Supabase.
# Ambas são públicas por design (prefixo NEXT_PUBLIC_) — a chave é a
# "publishable key", equivalente à antiga anon key. Nunca coloque a
# service_role key aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Webhook do Meta Lead Ads (Instagram/Facebook Ads) — ver o passo a passo em
# docs/superpowers/specs/2026-08-17-webhook-meta-lead-ads-design.md.
# Nunca prefixar com NEXT_PUBLIC_: são segredos usados só no servidor.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v20.0

# Métricas do Meta Ads (gasto por campanha → tela Anúncios do gestor).
# O passo a passo de como gerar os dois está NA PRÓPRIA TELA, abaixo do
# gráfico: token de System User com ads_read + ID numérico da conta de
# anúncios (sem o "act_"). Sem eles a tela funciona, só sem o gasto.
META_ADS_TOKEN=
META_ADS_ACCOUNT_ID=

# --- Assistente de WhatsApp com IA ---------------------------------------
# Chave de serviço do Supabase: o webhook do WhatsApp chega sem sessão de
# usuário e as tabelas da migration 0018 têm RLS `to authenticated` — sem
# esta chave nenhuma conversa é gravada. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Provedor de WhatsApp (Evolution API v2). Sem os dois preenchidos, o
# sistema NÃO envia mensagem nenhuma: nem a resposta da IA ao cliente, nem
# o alerta de lead quente ao corretor — e diz isso claramente na tela, em
# vez de fingir que enviou.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Segredo que o provedor deve mandar no header `x-webhook-secret` (ou
# `?token=`) ao chamar /api/webhooks/whatsapp. Em produção a rota recusa
# requisições sem ele — cada POST custa duas chamadas ao Gemini.
WHATSAPP_WEBHOOK_SECRET=

# URL pública desta aplicação que a Evolution deve chamar quando chegar
# mensagem. Gravada na instância do corretor no momento em que ele lê o QR.
# Ex.: https://seu-site.com.br/api/webhooks/whatsapp
WHATSAPP_WEBHOOK_URL=

# Token do desafio de verificação (GET) quando o provedor for a Meta Cloud API.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Gemini 2.0 Flash: agente conversacional, dossiê do lead, transcrição de
# áudio e variação anti-ban das campanhas. Sem ela tudo cai em modo de
# contingência (e a UI avisa).
# Provedor primário de IA: Groq (https://console.groq.com) — o mais rápido
# da cascata (~0,7s com reasoning_effort=low). Chave começa com `gsk_`.
# ATENÇÃO ao tier gratuito: o limite é de TOKENS por minuto (8.000 no
# gpt-oss-120b) e o prompt do agente gasta ~3.400 — ou seja, ~2 chamadas
# por minuto. É por isso que ele é o PRIMEIRO da cascata e não o único:
# quando estoura, o 429 custa 60ms e o provedor seguinte responde.
# GROQ_MODEL e GROQ_REASONING_EFFORT são opcionais.
GROQ_API_KEY=
GROQ_MODEL=
# Whisper da Groq: reserva da transcrição de áudio quando o Gemini falha.
# Usa a MESMA GROQ_API_KEY; só o modelo é configurável.
GROQ_AUDIO_MODEL=

# Segundo provedor: modelos hospedados da NVIDIA
# (https://build.nvidia.com/models). Gere em "Get API Key" — a chave começa
# com `nvapi-`. SEM ELA o sistema funciona igual, só pelo Gemini: a cascata
# em src/lib/whatsapp/llm.ts pula provedor sem chave.
# NVIDIA_MODEL é opcional (padrão: meta/llama-3.3-70b-instruct).
NVIDIA_API_KEY=
NVIDIA_MODEL=

GEMINI_API_KEY=
