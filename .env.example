# =========================================================================
# Copie para .env.local e preencha. Nada aqui é lido em produção — lá as
# variáveis vivem em Settings → Environment Variables na Vercel, e
# variável nova SÓ VALE DEPOIS DE UM REDEPLOY (as funções serverless
# congelam o ambiente no build; um 401 persistente depois de trocar um
# segredo quase sempre é só isso).
#
# Convenções deste arquivo:
#   - variável que você PRECISA preencher aparece como `NOME=`
#   - variável OPCIONAL aparece comentada, com o padrão anotado. Deixe
#     comentada: algumas são lidas com `??`, e presente-e-vazia não cai no
#     padrão — vira string vazia (ou 0).
#   - `NEXT_PUBLIC_` significa que o valor vai para o navegador. Segredo
#     nunca leva esse prefixo.
#
# O MÍNIMO para a vitrine pública subir são as duas primeiras variáveis.
# Painel, WhatsApp e IA exigem os blocos seguintes.
# =========================================================================


# --- Supabase (público) --------------------------------------------------
# As duas são públicas por design. A chave é a "publishable key",
# equivalente à antiga anon key. NUNCA ponha a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# --- Endereço público desta instalação -----------------------------------
# Usado em canonical, sitemap, Open Graph e nos links que o bot manda ao
# cliente (página do imóvel, catálogo do corretor). Sem ela, o padrão é
# https://next-home-drab.vercel.app — que é onde a aplicação de fato está.
# O domínio nexthomeimobiliaria.com.br AINDA NÃO aponta para cá: ele serve
# o site legado. Quando a virada de DNS acontecer, é esta variável que muda.
# NEXT_PUBLIC_SITE_URL=


# --- Supabase (servidor) -------------------------------------------------
# Chave de serviço. Os webhooks chegam sem sessão de usuário e as tabelas
# têm RLS `to authenticated` — sem esta chave nenhuma conversa é gravada,
# nenhum lead de anúncio entra. NUNCA prefixar com NEXT_PUBLIC_.
# (`SUPABASE_SERVICE_ROLE` é aceita como nome alternativo, para os scripts.)
SUPABASE_SECRET_KEY=


# =========================================================================
# INTELIGÊNCIA ARTIFICIAL
# =========================================================================
# O MOTOR É UM SÓ: a OpenAI. Não é decisão técnica — cada provedor escreve
# de um jeito, e a troca acontecia NO MEIO da conversa: o registro caía e a
# mensagem ficava mais informal, como se outra pessoa tivesse assumido o
# chat. Provedor pago é justamente o que não morre no meio.
#
# Falha do motor vira CONTINGÊNCIA (a mesma assistente, dizendo que vai
# confirmar), nunca troca de voz. As chaves gratuitas abaixo só voltam a
# atender quando o motor está SEM CHAVE — ambiente desconfigurado, não modo
# de operação. A ordem está em src/lib/whatsapp/llm.ts.

# Motor. Sem ela, TODO atendimento cai em contingência.
# OPENAI_MODEL é opcional (padrão: gpt-4.1-mini, escolhido medindo:
# `npm run bench:openai`). Modelos de raciocínio como gpt-5 reprovam por
# TEMPO — não cabem no orçamento de 60s do webhook.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Gemini. Tem DOIS papéis, e o segundo não é opcional:
#   1. reserva do motor (só quando a OpenAI está sem chave);
#   2. caminho ÚNICO de PDF (importação de leads e book de construtora,
#      via inlineData — modelo de texto não recebe arquivo) e primeira
#      escolha na transcrição de áudio do WhatsApp.
# Ou seja: sem ela, importar PDF e entender áudio param, mesmo com o motor
# no ar. A cota gratuita é de 20 chamadas/DIA POR MODELO e vira à
# meia-noite do Pacífico (04h de Brasília), não à meia-noite local.
# (`GOOGLE_AI_API_KEY` é aceita como nome alternativo.)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Groq. Reserva, e Whisper de reserva na transcrição de áudio. Chave começa
# com `gsk_`. O teto do tier gratuito é de TOKENS por minuto (8.000 no
# gpt-oss-120b) e o prompt do agente gasta ~3.400 — ou seja, ~2 chamadas
# por minuto.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_AUDIO_MODEL=            # usa a MESMA GROQ_API_KEY
# GROQ_REASONING_EFFORT=low    # só na família gpt-oss; `low` derruba a
#                              # saída de 1279 para 107 tokens
# GROQ_TPM_LIMITE=8000

# NVIDIA (https://build.nvidia.com/models → "Get API Key"). Reserva. Chave
# começa com `nvapi-`. O catálogo gratuito é quase todo INDISPONÍVEL: dos
# 44 candidatos de chat medidos, 21 devolvem `404 Not found for account` e
# 14 estouram o tempo. Não trate /v1/models como o que dá para usar, e
# meça latência E uma data de visita antes de trocar NVIDIA_MODEL.
NVIDIA_API_KEY=
# NVIDIA_MODEL=mistralai/mistral-nemotron

# Diagnóstico e eval — deixe comentadas no dia a dia.
# IA_ORDEM_PROVEDORES vale EXATAMENTE como escrita (não completa a lista
# com quem faltou), e é assim que o eval mede UM provedor sem outro
# responder por baixo. Typo em TODOS os nomes cai no padrão, para um erro
# de digitação não emudecer o atendimento.
# IA_ORDEM_PROVEDORES=openai
# IA_PROVEDOR_FORCADO=


# =========================================================================
# WHATSAPP (Evolution API v2)
# =========================================================================
# Ponte não-oficial, estilo WhatsApp Web: o número segue sendo o do
# corretor, no app dele. O risco está dito com todas as letras em
# docs/WHATSAPP_SETUP.md, que é o caminho do zero ao primeiro pareamento.

# Sem os dois, o sistema NÃO envia mensagem nenhuma: nem a resposta da IA
# ao cliente, nem o alerta de lead quente ao corretor — e diz isso na tela,
# em vez de fingir que enviou.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Segredo que o provedor manda no header `x-webhook-secret` (ou `?token=`)
# ao chamar /api/webhooks/whatsapp. Em produção a rota recusa requisição
# sem ele — falha fechada, porque cada POST custa chamadas pagas de IA.
WHATSAPP_WEBHOOK_SECRET=

# URL pública desta aplicação que a Evolution deve chamar quando chegar
# mensagem. Gravada na instância do corretor no momento do pareamento.
# Ex.: https://seu-site.com.br/api/webhooks/whatsapp
WHATSAPP_WEBHOOK_URL=

# Token do desafio de verificação (GET), só se o provedor for a Meta Cloud
# API em vez da Evolution.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=


# --- Cron ----------------------------------------------------------------
# Assina /api/cron/campanhas, /api/cron/followups e /api/cron/meta-ads. A
# Vercel manda `Authorization: Bearer $CRON_SECRET` sozinha quando a
# variável existe no projeto. O pg_cron do Supabase (0025) e os elos da
# corrente de disparo usam a MESMA assinatura — se trocar o valor aqui,
# rode de novo `configurar_disparo_automatico` e
# `configurar_followups_automaticos` no banco com o valor novo.
# Falha fechada: sem segredo, produção recusa tudo; em desenvolvimento
# local deixa passar, para dar para testar o disparo sem simular o cron.
CRON_SECRET=


# =========================================================================
# META (Instagram / Facebook)
# =========================================================================
# Webhook de Lead Ads → POST /api/webhooks/meta. Passo a passo no README e
# o design em docs/superpowers/specs/2026-08-17-webhook-meta-lead-ads-design.md.
# Nunca prefixar com NEXT_PUBLIC_: são segredos de servidor.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v20.0

# Métricas de gasto por campanha (tela Anúncios do gestor). O passo a passo
# de como gerar os dois está NA PRÓPRIA TELA, abaixo do gráfico: token de
# System User com `ads_read` + ID numérico da conta de anúncios (sem o
# "act_"). Sem eles a tela funciona, só sem o gasto.
META_ADS_TOKEN=
META_ADS_ACCOUNT_ID=


# --- Ingestão de lead por e-mail -----------------------------------------
# POST /api/webhooks/email-lead recebe o e-mail de portal (Zap, VivaReal,
# OLX, Imovelweb) e extrai um lead — ou a lista inteira, quando vêm dezenas
# na mesma mensagem. O remetente manda o segredo em `x-webhook-token`,
# `x-webhook-secret` ou `?token=`.
# Falha fechada, e por um motivo concreto: a checagem já foi
# `if (segredo && token !== segredo)`, ou seja, SEM a variável no ambiente
# o endpoint aceitava qualquer POST de qualquer origem e escrevia direto no
# CRM. Hoje, sem ela, a rota devolve 503.
INBOUND_EMAIL_WEBHOOK_SECRET=


# --- Google Drive --------------------------------------------------------
# Importar mídia de empreendimento por link de pasta aberta do Drive. Sem
# ela a funcionalidade some da tela com aviso, em vez de falhar no clique.
# GOOGLE_API_KEY=


# =========================================================================
# DESENVOLVIMENTO — nada disto é usado em produção
# =========================================================================

# Juiz do eval. O padrão é o Gemini; `openai` destrava a cota de 20/dia do
# Gemini, que é compartilhada com o ATENDIMENTO REAL — rodar eval na chave
# de produção esgota o balde do cliente de verdade.
# Juiz que avalia o próprio provedor dá nota para si mesmo: o eval ABORTA
# se `--provedor=X` coincidir com o juiz em X.
# EVAL_JUIZ=openai
# GEMINI_MODELO_JUIZ=gemini-3.5-flash-lite
# OPENAI_MODELO_JUIZ=gpt-4.1

# Cliente simulado do `npm run eval:conversa`. NÃO pode rodar no mesmo
# provedor do agente (a rodada aborta): modelo conversando consigo mesmo
# entende a própria pergunta mal formulada e nunca reproduz o mal-entendido
# — que é onde o atendimento real quebra.
# EVAL_CLIENTE_PROVEDOR=groq
# EVAL_CLIENTE_MODELO=openai/gpt-oss-20b
# EVAL_CLIENTE_MODELO_RESERVA=gpt-4o-mini
# EVAL_CLIENTE_TIMEOUT_MS=30000

# Playwright do painel. Estas duas moram em .env.e2e.local (fora do git),
# NÃO aqui. Sem elas o setup grava uma sessão vazia e os specs do painel
# PULAM com aviso, em vez de falhar.
# ATENÇÃO: o banco por trás é o de PRODUÇÃO — não há ambiente de teste.
# Todo spec do painel é read-only por contrato.
# E2E_CORRETOR_EMAIL=
# E2E_CORRETOR_SENHA=

# Scripts avulsos:
#   SUPABASE_PAT   — Management API, usada só por scripts/migrar.ts
#   DEBUG_PLANTA   — despeja o passo a passo da leitura de planta em PDF
# SUPABASE_PAT=
# DEBUG_PLANTA=

# ---------------------------------------------------------------------------
# E-mail (Resend) — só o aviso de queda do WhatsApp usa, por enquanto.
#
# Sem RESEND_API_KEY o envio falha FECHADO: registra no log e segue, sem
# derrubar o ciclo de disparo. O domínio precisa estar verificado no Resend
# para o remetente valer.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Opcional — sobrescreve "Next Home <avisos@nexthomeimobiliaria.com.br>".
EMAIL_REMETENTE=

# --- Geração de imagem (painel do corretor) -----------------------------
#
# Usa a MESMA OPENAI_API_KEY do motor de texto — não há chave separada.
#
# O modelo padrão é `gpt-image-2`, e a escolha foi medida em 03/09/2026: a
# conta alcança seis modelos de imagem e ele é o único SEM data de
# desligamento (`gpt-image-1` morre em 2026-10-23, outros três em 2026-12-01).
# Só mexa aqui para testar um modelo novo — e confira o `shutdown_date` em
# `GET /v1/models/<id>` antes de fixar.
#
# Sem crédito na conta, a tela recusa com o motivo escrito em vez de falhar
# em silêncio: geração de imagem custa por imagem, e bem mais que texto.
# OPENAI_IMAGE_MODEL=gpt-image-2
